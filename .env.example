# Database Configuration
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require
DB_POOL_MAX=3

# LocalGuide main database connection
MAIN_DATABASE_URL=postgresql://postgres:password@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# JWT Authentication
JWT_SECRET=your-super-secure-jwt-secret-min-32-characters
# JWT_EXPIRES_IN=7d

# Application Configuration
HOST=0.0.0.0
PORT=5001
NODE_ENV=development
# Public origin used in one-time admin password setup links.
ADMIN_APP_ORIGIN=https://ahhh-yaotu-admin.onrender.com

# Mailgun email delivery for admin password setup links.
# MAILGUN_API_KEY=key-...
# MAILGUN_DOMAIN=mg.example.com
# MAILGUN_FROM=YaoTu Admin <noreply@mg.example.com>

# LocalGuide staff assertion proxy.
# LOCALGUIDE_API_BASE_URL=https://ahhh-yaotu.onrender.com
# STAFF_ASSERTION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# STAFF_ASSERTION_ISSUER=yaotu-admin
# STAFF_ASSERTION_AUDIENCE=yaotu-localguide
# STAFF_ASSERTION_EXPIRES_IN=5m
