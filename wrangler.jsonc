{
  "name": "authflowmanager-v2",
  "main": "server/worker.ts",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist/public",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
