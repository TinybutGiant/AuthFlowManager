{
  "name": "authflowmanager-v2",
  "main": "server/worker.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "build": {
    "command": "npm run build:worker"
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "replit-localguide-pages.cloudflareaccess.com",
    "ACCESS_AUD": "916caa0f0611ab0f7dca4261fc3f2ea22c273a47926875d6236b024d131d6268",
    "LOCALGUIDE_API_BASE_URL": "https://ahhh-yaotu.onrender.com",
    "STAFF_ASSERTION_ISSUER": "yaotu-admin",
    "STAFF_ASSERTION_AUDIENCE": "yaotu-localguide"
  },
  "assets": {
    "directory": "./dist/public",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "hyperdrive": [
    {
      "binding": "AUTHFLOW_DB",
      "id": "830ccad3f0d7415280def2d2ec59e6fd"
    },
    {
      "binding": "MAIN_DB",
      "id": "f5cb2e058454400a967a5c0f1ad0462b"
    }
  ],
  "secrets": {
    "required": ["STAFF_ASSERTION_PRIVATE_KEY"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "local": {
      "name": "authflowmanager-v2-local",
      "compatibility_date": "2026-08-31",
      "compatibility_flags": ["nodejs_compat"],
      "workers_dev": false,
      "preview_urls": false,
      "build": {
        "command": "npm run build:worker:dev",
        "watch_dir": ["client", "server", "shared"]
      },
      "vars": {
        "V2_LOCAL_DEV_AUTH": "true",
        "V2_LOCAL_DEV_STAFF_EMAIL": "local-owner@authflowmanager.test",
        "ACCESS_TEAM_DOMAIN": "local.cloudflareaccess.invalid",
        "ACCESS_AUD": "local-dev",
        "LOCALGUIDE_API_BASE_URL": "http://127.0.0.1:59999",
        "STAFF_ASSERTION_ISSUER": "yaotu-admin-local",
        "STAFF_ASSERTION_AUDIENCE": "yaotu-localguide-local"
      },
      "assets": {
        "directory": "./dist/public",
        "not_found_handling": "single-page-application",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"]
      },
      "hyperdrive": [
        {
          "binding": "AUTHFLOW_DB",
          "id": "local-authflow-db",
          "localConnectionString": "postgresql://postgres:authflowdev@127.0.0.1:55434/authflowmanager_v2_authflow_dev?sslmode=disable"
        },
        {
          "binding": "MAIN_DB",
          "id": "local-main-db",
          "localConnectionString": "postgresql://postgres:authflowdev@127.0.0.1:55434/authflowmanager_v2_main_dev?sslmode=disable"
        }
      ],
      "secrets": {
        "required": []
      },
      "observability": {
        "enabled": false
      }
    }
  }
}
