{
  "name": "authflowmanager-v2",
  "main": "server/worker.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/public",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "hyperdrive": [
    {
      "binding": "AUTHFLOW_DB",
      "id": "830ccad3f0d7415280def2d2ec59e6fd"
    },
    {
      "binding": "MAIN_DB",
      "id": "f5cb2e058454400a967a5c0f1ad0462b"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
